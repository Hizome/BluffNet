# BluffNet LLM config template
# Copy this file to backend/.env and fill real values.

# =========================
# Default profile (optional)
# Used when player profile is empty or not found.
# =========================
LLM_PROVIDER=openai
LLM_API_KEY=your_default_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# =========================
# AI1 profile (OpenAI-compatible)
# =========================
LLM_AI1_PROVIDER=openai
LLM_AI1_API_KEY=your_api_key
LLM_AI1_BASE_URL=https://api.openai.com/v1
LLM_AI1_MODEL=gpt-4o-mini

# =========================
# AI2 profile (Anthropic-compatible / MiniMax example)
# =========================
LLM_AI2_PROVIDER=anthropic
LLM_AI2_ANTHROPIC_API_KEY=your_minimax_api_key
LLM_AI2_ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
LLM_AI2_ANTHROPIC_MODEL=MiniMax-M2.5
# Optional fallback aliases (either is accepted by the backend):
# LLM_AI2_API_KEY=your_minimax_api_key
# LLM_AI2_BASE_URL=https://api.minimaxi.com/anthropic
# LLM_AI2_MODEL=MiniMax-M2.5

# =========================
# Reliability / timeout
# =========================
LLM_TIMEOUT_SEC=30
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SEC=0.8
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512
