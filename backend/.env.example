# Standardized OpenAI-Compatible LLM Configuration
# Default (Fallback)
LLM_API_KEY=your_default_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4

# Profile: AI1 (e.g., Gemini via proxy)
LLM_AI1_API_KEY=your_ai1_key
LLM_AI1_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_AI1_MODEL=gemini-1.5-flash

# Profile: AI2 (e.g., Claude via proxy)
LLM_AI2_API_KEY=your_ai2_key
LLM_AI2_BASE_URL=https://api.anthropic.com/v1
LLM_AI2_MODEL=claude-3-5-sonnet
